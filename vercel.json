{
  "version": 2,
  "routes": [
    { "src": "^/$", "dest": "/login.html" },
    { "src": "^/login$", "dest": "/login.html" },
    { "src": "^/dashboard$", "dest": "/dashboard.html" },
    { "src": "^/(.*)$", "dest": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
