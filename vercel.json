{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "api/data.js", "use": "@vercel/node" },
    { "src": "api/hyperm-mobile.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "admin/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/api/hyperm-mobile/?(.*)$", "dest": "/api/hyperm-mobile.js" },
    { "src": "^/api/1\\.3/?(.*)$", "dest": "/api/index.js" },
    { "src": "^/api/1\\.2/?(.*)$", "dest": "/api/index.js" },
    { "src": "^/api/1\\.0/?(.*)$", "dest": "/api/index.js" },
    { "src": "^/api/1\\.1/?(.*)$", "dest": "/api/index.js" },
    { "src": "^/api/?$", "dest": "/api/index.js" },
    { "src": "^/api/data/?$", "dest": "/api/data.js" },
    { "src": "^/api_admin\\.php/?(.*)$", "dest": "/api/index.js" },
    { "src": "^/admin/api\\.php/?(.*)$", "dest": "/api/index.js" },
    { "src": "^/$", "dest": "/login.html" },
    { "src": "^/login/?$", "dest": "/login.html" },
    { "src": "^/login.html/?$", "dest": "/login.html" },
    { "src": "^/dashboard/?$", "dest": "/dashboard.html" },
    { "src": "^/dashboard.html/?$", "dest": "/dashboard.html" },
    { "src": "^/(.*)$", "dest": "/$1" }
  ]
}