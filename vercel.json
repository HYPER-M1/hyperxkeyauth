{
  "version": 2,
  "builds": [
    { "src": "api/data.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "admin/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/api/data/?$", "dest": "/api/data.js" },
    { "src": "^/$", "dest": "/login.html" },
    { "src": "^/login$", "dest": "/login.html" },
    { "src": "^/dashboard$", "dest": "/dashboard.html" },
    { "src": "^/(.*)$", "dest": "/$1" }
  ]
}
